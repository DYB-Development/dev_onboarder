<%
  state_badges = {
    met: { label: "Met", variant: :success },
    new: { label: "New", variant: :info },
    changed: { label: "Changed", variant: :warning },
    not_met: { label: "Not met", variant: :danger }
  }

  requirement_columns = [
    Keystone::Ui::Column.new(:requirement, "Requirement"),
    Keystone::Ui::Column.new(:purpose, "Purpose"),
    Keystone::Ui::Column.new(:state, "State"),
    Keystone::Ui::Column.new(:last_checked, "Last checked", mobile_hidden: true)
  ]
%>

<%= ui_page do %>
  <% if @overview.notice.present? %>
    <%= ui_alert(message: @overview.notice, type: :warning) %>
  <% end %>

  <% @overview.groups.each do |group| %>
    <%
      requirement_rows = group.rows.map do |row|
        {
          requirement: row.requirement.key.to_s,
          purpose: row.requirement.purpose,
          state: ui_badge(**state_badges.fetch(row.state)),
          last_checked: row.checked_at ? row.checked_at.utc.strftime("%Y-%m-%d %H:%M UTC") : "Never"
        }
      end
    %>
    <%= ui_section(title: group.name.to_s.tr("_", " ").capitalize) do %>
      <%= ui_data_table(items: requirement_rows, columns: requirement_columns) %>
    <% end %>
  <% end %>
<% end %>
